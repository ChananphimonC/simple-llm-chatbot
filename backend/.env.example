# --- Gemini Live (real-time voice) - all optional ---
# Verify the model id in Google AI Studio; Live model names change often.
# LIVE_MODEL=gemini-3.1-flash-live-preview
# LIVE_VOICE=Kore
# Ms of silence before Gemini answers. Lower = faster replies, but cuts off people who pause mid-sentence.
# LIVE_SILENCE_MS=500
# Reasoning before speaking is pure latency in voice chat. Leave empty to omit if the model rejects it.
# LIVE_THINKING_LEVEL=MINIMAL
